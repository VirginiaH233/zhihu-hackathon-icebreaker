# 社恐破冰船 · 环境变量模板
#
# 本地：复制本文件为 `.env` 并填值（`.env` 已在 .gitignore 里，**永不入库**）
# 线上（Railway 等）：不用 .env —— 在平台的环境变量里填同样的 key 即可
#   （代码逻辑：环境变量优先，.env 兜底）

# ---- 知乎开放平台 · OAuth 登录（必需；提报后由官方发放）----
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 回调地址：必须是公网 HTTPS，且与开放平台登记的值**完全一致**
ZHIHU_OAUTH_REDIRECT_URI=https://<your-domain>/oauth/callback

# ---- 知乎开放平台 · 读「授权用户自己」的创作（必需）----
# 「生成你的分身」靠它读本人内容；不填则该功能不可用（接口会直接返回需要登录）
ZHIHU_ACCESS_SECRET=

# ---- 可选 ----
# zhihu-cli 可执行文件路径（不填则走 PATH / 默认安装位置）
ZHIHU_CLI=
# 备用渠道凭证（当前未使用）
ZHIHU_MOLTBOOK_APP_KEY=
ZHIHU_MOLTBOOK_APP_SECRET=
